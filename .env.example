# Backend
PORT=3001

# Default/local cluster. Empty values use normal ~/.kube/config discovery.
KUBECONFIG=
KUBE_CONTEXT=

# Required only when token/password credentials are saved from User control panel.
# Use a random value of at least 32 characters and never commit the real .env file.
# Example: openssl rand -hex 32
DASHBOARD_MASTER_KEY=

# Optional encrypted cluster registry location.
# Default: server/data/clusters.json
CLUSTER_STORE_PATH=
