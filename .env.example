# Backend
PORT=3001

# Required for encrypting saved cluster credentials. Keep it stable: changing the
# key makes existing credentials unreadable. Never commit the real .env file.
# Example: openssl rand -hex 32
DASHBOARD_MASTER_KEY=

# Optional data paths. Leave empty to use the package's data directory in the
# standalone build, or server/data during the normal npm launch.
USER_DATABASE_PATH=

BOOTSTRAP_USER_PATH=

CLUSTER_STORE_PATH=

# Optional directory with the built frontend. The standalone binary selects its
# bundled public directory automatically.
STATIC_DIR=
