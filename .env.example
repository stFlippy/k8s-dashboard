# Backend
PORT=3001

# Optional legacy/default cluster from the backend host.
# New clusters are normally added per user in the UI.
KUBECONFIG=
KUBE_CONTEXT=

# Required for encrypting saved cluster credentials. Keep it stable: changing the
# key makes existing credentials unreadable. Never commit the real .env file.
# Example: openssl rand -hex 32
DASHBOARD_MASTER_KEY=

# Optional data paths (defaults are shown before each value).
# Default: server/data/users.sqlite
USER_DATABASE_PATH=

# Default: server/data/bootstrap-user.json
BOOTSTRAP_USER_PATH=

# Default: server/data/clusters.json (legacy/migration store)
CLUSTER_STORE_PATH=
